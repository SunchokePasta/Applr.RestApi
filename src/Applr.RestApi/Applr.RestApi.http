@Applr.RestApi_HostAddress = http://localhost:5094

### Every profile field with its active patterns, in match order.
### This is the call ApplrFiller makes to rebuild its matcher.
###
### Each pattern is an object, not a bare string, because its type decides how
### the filler reads it -- 'regex' is run as a regex, 'literal' is matched as
### plain text:
###
###   { "fieldKey": "email", "displayName": "Email", "matchOrder": 60,
###     "mirrorsKey": null, "isSensitive": false,
###     "patterns": [ { "pattern": "e-?mail", "matchType": "regex" },
###                   { "pattern": "verify your address", "matchType": "literal" } ] }
###
### Before 2026-09-21 patterns was a list of strings and the type was dropped.
GET {{Applr.RestApi_HostAddress}}/profile/fields
Accept: application/json

###

### One user's answers, as a field key to ranked list map -- the preferred
### answer first, then the fallbacks. An unanswered field is an empty list.
GET {{Applr.RestApi_HostAddress}}/profile/values/1
Accept: application/json

###

### Add a wording for a field that already exists -- the resolver's 'existing'
### verdict, where the value is held and only the label was unfamiliar.
### Lands as 'pending', so it is recorded without affecting matching.
### matchType is 'regex' or 'literal' and defaults to 'regex' when omitted.
POST {{Applr.RestApi_HostAddress}}/profile/fields/email/patterns
Content-Type: application/json

{
  "pattern": "verify your address",
  "matchType": "literal",
  "domain": "",
  "source": "llm",
  "status": "pending",
  "confidence": 0.91,
  "llmRunId": "4adbcb2a"
}

###

### Same, scoped to one site -- for a wording that means something different
### elsewhere ("Reference" is a reference number on one board, a referee on another).
POST {{Applr.RestApi_HostAddress}}/profile/fields/surname/patterns
Content-Type: application/json

{
  "pattern": "reference",
  "matchType": "literal",
  "domain": "example-jobs.com",
  "source": "user",
  "status": "active"
}

###

### Create a field and its first pattern together -- the resolver's 'new'
### verdict. Omit matchOrder to append past the existing fields; supply one
### only to place a field deliberately.
POST {{Applr.RestApi_HostAddress}}/profile/fields
Content-Type: application/json

{
  "fieldKey": "national_insurance_number",
  "displayName": "National Insurance number",
  "isSensitive": false,
  "pattern": "national insurance",
  "matchType": "literal",
  "domain": "",
  "source": "llm",
  "status": "pending",
  "confidence": 0.88,
  "llmRunId": "4adbcb2a"
}

###

### A field that is an attestation the user signs rather than data we hold.
### isSensitive is a flag only: ApplrFiller fills any field a pattern recognises
### and an answer exists for.
POST {{Applr.RestApi_HostAddress}}/profile/fields
Content-Type: application/json

{
  "fieldKey": "right_to_work",
  "displayName": "Right to work confirmation",
  "isSensitive": true,
  "pattern": "right to work",
  "matchType": "literal",
  "source": "llm",
  "status": "pending"
}

###

### Set one user's answer for one field. Rank is optional and defaults to 1, the
### preferred answer. Idempotent -- a repeat call updates that rank rather than
### duplicating, because the key is (user_id, field_key, value_rank).
PUT {{Applr.RestApi_HostAddress}}/profile/values/1/national_insurance_number
Content-Type: application/json

{
  "value": "QQ123456C"
}

###

### A fallback answer for the same field. The filler tries rank 1 first and
### moves down the ranks when a page's options do not include it. Rank runs
### from 1 to 255; anything else is a 400.
PUT {{Applr.RestApi_HostAddress}}/profile/values/1/country
Content-Type: application/json

{
  "value": "UK",
  "rank": 2
}

###

### Confirmation fields are derived, not stored -- confirm_email mirrors email
### via mirrors_key, so setting email is enough for both.
PUT {{Applr.RestApi_HostAddress}}/profile/values/1/email
Content-Type: application/json

{
  "value": "anjolatiamiyu28@gmail.com"
}

###
